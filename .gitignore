# --- OS junk ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- PHP / Composer (only matters once you add Composer) ---
/vendor/
composer.phar

# --- Environment / secrets ---
# If you move the hardcoded credentials in features/db.php into a
# .env file (recommended), make sure it's ignored:
.env
.env.*
!.env.example

# --- Logs & cache ---
*.log
/cache/
/tmp/

# --- Local server / DB dumps ---
*.sql.bak
*.sqlite
